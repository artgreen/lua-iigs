    "echo LUACPROBE step reject-syntax",
    "unset exit",
    "20:luactest -p lc.bad.lua >&lc.bad.log",
    "set lcstatus {status}",
    "set exit on",
    "echo LUACPROBE step syntax",
    "20:luatest -E test.lua syntax {lcstatus}",
    "echo LUACPROBE step reject-depth",
    "unset exit",
    "20:luactest -p lc.deep.lua >&lc.deep.log",
    "set lcstatus {status}",
    "set exit on",
    "echo LUACPROBE step depth",
