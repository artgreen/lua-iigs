    "echo LUACPROBE step compile-recovery",
    "20:luactest -o lc.again.out lc.small.lua",
    "echo LUACPROBE step recovery",
    "20:luatest -E test.lua recovery",
    "echo LUACPROBE step finish",
    "20:luatest -E test.lua finish",
    "exit 0"
